$js = <<<'JS'
(function () {
    'use strict';
    var root = document.getElementById('okxpay');
    if (!root || !window.fetch) {
        return;
    }
    var cfg = JSON.parse(root.getAttribute('data-config'));
    var messages = JSON.parse(root.getAttribute('data-messages'));
    var status = cfg.status;
    var deadline = Date.now() + cfg.secondsLeft * 1000;
    var tokenIndex = 0;
    var submitted = false;

    function find(selector) {
        return root.querySelector(selector);
    }

    function show(state, text) {
        root.setAttribute('data-status', state);
        find('[data-role="status-text"]').textContent = text || messages[state] || messages.pending;
    }

    function tick() {
        var left = Math.max(0, Math.round((deadline - Date.now()) / 1000));
        find('[data-role="timer"]').textContent = Math.floor(left / 60) + ':' + ('0' + left % 60).slice(-2);
    }

    function update(data) {
        if (!data || !data.status) {
            return;
        }
        if (typeof data.secondsLeft === 'number') {
            deadline = Date.now() + data.secondsLeft * 1000;
        }
        if (data.status === status) {
            return;
        }
        status = data.status;
        show(status);
        if (status === 'paid' && data.redirect) {
            setTimeout(function () {
                window.location.assign(data.redirect);
            }, 1500);
        }
    }

    function poll() {
        var url = cfg.statusUrl + (cfg.statusUrl.indexOf('?') < 0 ? '?' : '&')
            + 'token=' + encodeURIComponent(cfg.token);
        fetch(url, {credentials: 'same-origin', headers: {'Accept': 'application/json'}})
            .then(function (response) {
                return response.json();
            })
            .then(update)
            .catch(function () {})
            .then(function () {
                if (status === 'pending') {
                    setTimeout(poll, cfg.pollInterval);
                }
            });
    }

    function post(url, data) {
        var body = new URLSearchParams();
        body.append('form_key', cfg.formKey);
        Object.keys(data).forEach(function (key) {
            body.append(key, data[key]);
        });
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Accept': 'application/json'},
            body: body
        })
            .then(function (response) {
                return response.json();
            });
    }

    function copy(value) {
        if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(value);
        }
        var area = document.createElement('textarea');
        area.value = value;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        try {
            document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(area);
        return Promise.resolve();
    }

    root.querySelectorAll('[data-copy]').forEach(function (button) {
        var label = button.textContent;
        button.addEventListener('click', function () {
            copy(button.getAttribute('data-copy')).catch(function () {}).then(function () {
                button.textContent = messages.copied;
                button.classList.add('is-done');
                setTimeout(function () {
                    button.textContent = label;
                    button.classList.remove('is-done');
                }, 1500);
            });
        });
    });

    root.querySelectorAll('[data-token-index]').forEach(function (button) {
        button.addEventListener('click', function () {
            tokenIndex = parseInt(button.getAttribute('data-token-index'), 10);
            root.querySelectorAll('[data-token-index]').forEach(function (other) {
                other.classList.toggle('is-active', other === button);
                other.setAttribute('aria-checked', other === button ? 'true' : 'false');
            });
            find('[data-role="coin"]').textContent = cfg.wallet.tokens[tokenIndex].symbol;
            find('[data-role="token-address"]').textContent = cfg.wallet.tokens[tokenIndex].address;
        });
    });

    function provider() {
        return window.okxwallet || window.ethereum || null;
    }

    function switchChain(wallet) {
        var chain = cfg.wallet;
        return wallet.request({method: 'wallet_switchEthereumChain', params: [{chainId: chain.chainId}]})
            .catch(function (error) {
                var original = error && error.data && error.data.originalError;
                var code = error && (error.code || (original && original.code));
                if (code !== 4902) {
                    throw error;
                }
                return wallet.request({method: 'wallet_addEthereumChain', params: [{
                    chainId: chain.chainId,
                    chainName: chain.chainName,
                    nativeCurrency: {name: 'OKB', symbol: 'OKB', decimals: 18},
                    rpcUrls: [chain.rpcUrl],
                    blockExplorerUrls: [chain.explorerUrl]
                }]});
            });
    }

    function payWithWallet(button) {
        var wallet = provider();
        var token = cfg.wallet.tokens[tokenIndex];
        if (!wallet) {
            return;
        }
        button.disabled = true;
        show('pending', messages.walletConfirm);
        wallet.request({method: 'eth_requestAccounts'})
            .then(function (accounts) {
                return switchChain(wallet).then(function () {
                    return accounts[0];
                });
            })
            .then(function (from) {
                return wallet.request({method: 'eth_sendTransaction', params: [{
                    from: from,
                    to: token.address,
                    data: cfg.wallet.data,
                    value: '0x0'
                }]});
            })
            .then(function (txHash) {
                submitted = true;
                show('pending', messages.submitted);
                return post(cfg.submitUrl, {token: cfg.token, tx_hash: txHash}).then(update);
            })
            .catch(function (error) {
                if (!submitted) {
                    show('pending', error && error.code === 4001
                        ? messages.walletRejected
                        : messages.walletError + (error && error.message ? ' (' + error.message + ')' : ''));
                }
            })
            .then(function () {
                button.disabled = submitted;
            });
    }

    var payButton = find('[data-role="wallet-pay"]');
    if (payButton) {
        var detect = function () {
            var found = !!provider();
            payButton.hidden = !found;
            find('[data-role="wallet-hint"]').hidden = found;
        };
        detect();
        setTimeout(detect, 600);
        payButton.addEventListener('click', function () {
            payWithWallet(payButton);
        });
    }

    var cancelForm = find('[data-role="cancel-form"]');
    if (cancelForm) {
        cancelForm.addEventListener('submit', function (event) {
            if (!window.confirm(messages.cancelConfirm)) {
                event.preventDefault();
            }
        });
    }

    tick();
    setInterval(tick, 1000);
    if (status === 'pending') {
        setTimeout(poll, cfg.pollInterval);
    }
})();
JS;
