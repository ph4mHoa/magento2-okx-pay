{
    "name": "joepham/module-okx-pay",
    "description": "OKX crypto payment gateway for Magento 2 / Adobe Commerce: accept USDT and USDC by OKX app internal transfer (confirmed with a read-only OKX API v5 key), or USDT and USDG from OKX Wallet on X Layer.",
    "type": "magento2-module",
    "license": "MIT",
    "homepage": "https://github.com/ph4mHoa/magento2-okx-pay",
    "keywords": [
        "magento2",
        "magento-2",
        "adobe-commerce",
        "okx",
        "okx-wallet",
        "x-layer",
        "usdt",
        "usdg",
        "crypto-payment",
        "payment-gateway"
    ],
    "authors": [
        {
            "name": "Joe Pham",
            "homepage": "https://github.com/ph4mHoa"
        }
    ],
    "support": {
        "issues": "https://github.com/ph4mHoa/magento2-okx-pay/issues",
        "source": "https://github.com/ph4mHoa/magento2-okx-pay"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "ext-json": "*",
        "ext-bcmath": "*",
        "bacon/bacon-qr-code": "^2.0.8||^3.0",
        "magento/framework": "^103.0",
        "magento/module-checkout": "^100.4",
        "magento/module-directory": "^100.4",
        "magento/module-payment": "^100.4",
        "magento/module-sales": "^103.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "JoePham\\OkxPay\\": ""
        }
    }
}
